# Server
NODE_ENV=development
PORT=5000

# Database (Supabase PostgreSQL - managed, cloud-hosted)
# Get your connection string from Supabase Dashboard -> Project Settings -> Database.
# Template for a DIRECT connection (recommended for Prisma migrations + dev):
#   postgresql://postgres:<DATABASE_PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres
# Template for the TRANSACTION POOLER (port 6543) if you prefer a pooler:
#   postgresql://postgres.<PROJECT_REF>:<DATABASE_PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# Replace the placeholders below with your real values - never commit real credentials.
DATABASE_URL="postgresql://postgres:YOUR_DATABASE_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"

# Auth
# Generate a strong secret, e.g.: openssl rand -hex 32
JWT_SECRET=change_me_to_a_long_random_secret_at_least_16_chars
JWT_EXPIRES_IN=1d
BCRYPT_ROUNDS=10

# CORS - comma separated origins or * for any
CORS_ORIGIN=*