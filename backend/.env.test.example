# Test configuration - overrides DATABASE_URL when NODE_ENV=test.
# Uses a dedicated "test" schema on the SAME Supabase project so tests never
# touch your real (public) data. The schema is created automatically in
# tests/global-setup.js. Replace placeholders with your real values.
NODE_ENV=test
PORT=5001

DATABASE_URL="postgresql://postgres:YOUR_DATABASE_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?schema=test"

JWT_SECRET=test_only_secret_must_be_at_least_16_chars
JWT_EXPIRES_IN=1h
BCRYPT_ROUNDS=4
CORS_ORIGIN=*